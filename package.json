{
  "name": "xiaomang",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:server",
    "dev:web": "npm run dev --workspace @xiaomang/web",
    "dev:server": "npm run dev --workspace @xiaomang/server",
    "build": "npm run build --workspace @xiaomang/web",
    "start": "npm run start --workspace @xiaomang/server",
    "test": "npm run test --workspace @xiaomang/server",
    "verify:routes": "npm run verify:routes --workspace @xiaomang/server",
    "verify:render": "npm run verify:render --workspace @xiaomang/server",
    "verify:concurrency": "npm run verify:concurrency --workspace @xiaomang/server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
